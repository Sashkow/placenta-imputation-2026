# Large regenerable expression matrices for secondary pipeline variants.
# Only the primary run (data/pipeline/main/) ships its full matrices; for the
# sensitivity/comparison variants the DE tables and summaries are enough to
# reproduce every reported number, and the matrices are regenerated by
# `Rscript scripts/run_everything.R --full`.
data/pipeline/covariate_categorical/exprs_*.tsv
data/pipeline/covariate_poly2/exprs_*.tsv
data/pipeline/covariate_ns3/exprs_*.tsv
data/pipeline/ga_matched_prater/exprs_*.tsv
data/pipeline/sensitivity/exprs_*.tsv
# archive copies of replaced holdout outputs (git history keeps the old versions)
data/pipeline/holdout/*/archive/
.~lock.*#
# regenerable corrected matrices of the route comparison and the seed runs
data/pipeline/routes/corrected_*.rds
data/pipeline/imputed_influence/seeds/*.rds
